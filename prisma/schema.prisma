generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ─────────────────────────────────────────────────────────────────────

/// A group of people who share projects, templates and export defaults.
///
/// Mercato started single-tenant: every row belonged to one user and an admin
/// saw everything. A team sits between those — its members share work, and a
/// team_admin administers only their own team.
///
/// Nullable everywhere it is referenced, on purpose. Rows that predate teams,
/// and genuinely global ones (an admin's template, a compliance default that
/// applies to every client), carry no team and stay visible to all.
model Team {
  id   String @id @default(cuid())
  name String
  /// URL-safe handle, unique. Used in admin screens, never in a route yet.
  slug String @unique
  /// The ceiling for this team. A team_admin may grant its members any subset
  /// of this list and never anything outside it.
  allowedMarketplaces String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  projects  Project[]
  templates ExportTemplate[]
  defaults  ExportDefault[]

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  /// "user" | "team_admin" | "admin".
  /// "admin" is the super admin and predates teams — it is deliberately NOT
  /// renamed, so no existing row has to be migrated.
  role          String    @default("user")
  /// Null for rows that predate teams, and for the super admin.
  teamId        String?
  // Marketplace ids a non-admin user may create projects for. Empty = none
  // allowed (explicit allow-list). Admins ignore this and see all.
  allowedMarketplaces String[] @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  projects  Project[]
  templates ExportTemplate[]
  team      Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core ─────────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  userId      String
  /// Stamped from the creator's team. Null on rows that predate teams.
  teamId      String?
  name        String
  marketplace String   // amazon | bestbuy | walmart | temu | mathis | sears
  status      String   @default("uploaded") // uploaded | verifying | verified | categorizing | categorized | exporting | done
  // New-listing projects have no live marketplace page to verify against, so the
  // Verify step is skipped and the flow goes straight to Categorize.
  isNewListing Boolean @default(false)

  // Processing timers. Verification is resumable across several "Continue"
  // requests, so we accumulate the ACTIVE processing time of each pass (idle
  // gaps between resumes are not counted). `*CompletedAt` is set when the phase
  // fully finishes, which is also the signal the UI uses to show the summary.
  verifyMs          Int?      // total active verification time in ms
  verifyCompletedAt DateTime?
  categorizeMs          Int?  // total active categorization time in ms
  categorizeCompletedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([teamId])
}

model Product {
  id          String  @id @default(cuid())
  projectId   String
  vendorSku   String?
  upc         String?
  asin        String?
  name        String
  brand       String?
  description String?
  price       Float?
  imageUrl    String?
  vendorData  Json?   // full raw vendor row

  // Verification
  verifyStatus String?   // ok | warning | mismatch | not_found | pending
  liveData     Json?     // raw marketplace response
  verifyFields Json?     // field-by-field comparison array
  verifiedAt   DateTime?

  // Categorization
  marketplaceCategory String?
  categoryPath        String?
  categoryConfidence  Float?
  categorizedAt       DateTime?
  // Walmart new-listing: the "Spec Product Type" assigned from Walmart's PT
  // taxonomy (required on the new-listing template). Null for other flows.
  specProductType     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Values resolved once (catalog lookup or AI) and reused by later exports.
  attributes ProductAttribute[]

  @@index([upc])
  @@index([asin])
  /// Every per-project query filters on this; without it even loading a project
  /// scans the whole products table.
  @@index([projectId])
  /// Backs the incremental verification feed, which pages through verified rows
  /// ordered by (verifiedAt, id). Polling that ordering without an index means a
  /// full scan on every poll of a large project.
  @@index([projectId, verifiedAt, id])
}

// ── Keepa cache (Amazon only) ─────────────────────────────────────────────────
// Keepa bills per product token, so every lookup we can answer locally is money
// saved. Two tables because the two halves age very differently: a barcode→ASIN
// binding is effectively permanent, while product data goes stale.

/// Barcode → ASIN resolution, keyed by canonical GTIN-14 (see lib/barcode.ts).
///
/// This is the expensive half. A code that misses the batch lookup currently
/// costs a rescue call plus up to ~10 keyword-search calls, so remembering the
/// answer — including "there is no answer" — is where most of the savings are.
model KeepaCodeLookup {
  code      String // canonical GTIN-14
  domain    Int // Keepa domain id (1 = amazon.com)
  asins     String[] // empty = confirmed absent from Amazon (negative cache)
  /// How the mapping was resolved. Keyword matches are fuzzy guesses rather
  /// than authoritative barcode hits, so they expire sooner. "sibling" = a
  /// pack-sibling rescue pick whose ASIN legitimately carries a different
  /// barcode than the code it answers for.
  source    String // batch | rescue | keyword | sibling
  fetchedAt DateTime @default(now())

  @@id([code, domain])
  @@index([fetchedAt])
}

/// ASIN → raw Keepa product payload.
///
/// Stores the raw KeepaProduct, not the normalized shape: normalizeProduct() is
/// a pure function, so keeping it outside the cache boundary means normalization
/// logic can change without invalidating stored rows.
model KeepaProductCache {
  asin      String
  domain    Int
  raw       Json // full KeepaProduct as returned by the API
  /// Split out because it ages differently from the rest of the payload: price
  /// feeds candidate scoring and export files, so a stale value picks the wrong
  /// ASIN. Identity fields (title/brand/dimensions) effectively never change.
  priceAt   DateTime @default(now())
  fetchedAt DateTime @default(now())

  @@id([asin, domain])
  @@index([fetchedAt])
}

// ── Walmart lookup cache ──────────────────────────────────────────────────────

/// Barcode → resolved Walmart item payload.
///
/// Walmart verification costs up to 5 sequential API calls per unresolved
/// product, so a remembered answer — including a remembered absence — is the
/// difference between a 10k run taking minutes and taking an hour. Keyed by
/// GTIN-14 like the Keepa cache so both normalize the same way.
///
/// `item` is null for a confirmed "Walmart has nothing for this code" (negative
/// cache). `source` records which API answered, because the seller catalog is
/// authoritative about our own listings while an affiliate name-search hit is a
/// fuzzy guess that should expire sooner.
model WalmartItemCache {
  code      String // canonical GTIN-14, or "q:<hash>" for name-search queries
  item      Json? // normalized item payload; null = confirmed absent
  source    String // seller | upc | name
  fetchedAt DateTime @default(now())

  @@id([code])
  @@index([fetchedAt])
}

// ── Templates ─────────────────────────────────────────────────────────────────

model ExportTemplate {
  id          String   @id @default(cuid())
  userId      String?  // null = global (admin-created); set = user-private
  /// Set = visible to that team only. Null WITH a null userId means truly
  /// global; the two fields together answer "who may use this template".
  teamId      String?
  name        String
  marketplace String
  category    String?
  fileFormat  String   @default("xlsx") // xlsx | csv
  columns     Json     // [{ key, label, required }]
  fileData    Bytes?   // raw uploaded template file — used as base workbook on export
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

// ── Export jobs ───────────────────────────────────────────────────────────────

// Durable export-job state. Job progress AND the finished ZIP live here rather
// than in a server instance's memory: on a serverless deployment a status poll
// can land on any instance, and the instance that built the ZIP can be frozen
// or recycled at any moment. Rows are pruned by createJob after 48h.
model ExportJob {
  id          String   @id // `${projectId}_${startedAtMs}` — minted by the export POST
  projectId   String
  userId      String   // owner — polls from other users are refused
  status      String   @default("processing") // processing | done | error
  phase       String?  // human-readable progress ("Building spreadsheet files…")
  error       String?
  zip         Bytes?   // finished payload (ZIP or bare spreadsheet), set when done
  extension   String?  // zip | xlsx | csv
  contentType String?
  missingTemplateCategories Json? // string[] — Temu categories with no matching template
  /// string[] — output groups still to be written. An export is built one slice
  /// per request because the whole job cannot fit in one serverless
  /// invocation; this is what the next request picks up.
  pendingGroups Json?
  /// How many groups the job started with, so progress can be reported.
  totalGroups   Int?
  /// { columns: [{ label, rows }], aiUnavailable } — REQUIRED cells this export
  /// shipped empty, rolled up per column, plus whether the AI was reachable at
  /// all. Kept so the export screen can offer to set a default for a genuinely
  /// unanswerable column — and can refuse to offer one when the cells are empty
  /// merely because the AI had no credit.
  unfilledRequired Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) // heartbeat — bumped on every phase/touch

  files ExportJobFile[]

  @@index([updatedAt])
}

/// One finished file of an export, kept until the whole job is assembled.
///
/// A large export does not fit in one 300-second serverless invocation, and
/// before this every attempt threw away everything it had written. Each output
/// file is stored the moment it is finished, so the next request starts from
/// the first group that is still missing rather than from the beginning.
///
/// Deleted as a set once the ZIP is assembled, and with the job itself when the
/// 48-hour retention sweep runs.
model ExportJobFile {
  id        String   @id @default(cuid())
  jobId     String
  /// Path inside the finished ZIP, e.g. "Furniture.xlsx".
  name      String
  data      Bytes
  createdAt DateTime @default(now())

  job ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@index([jobId])
}

// ── Paid-service usage ────────────────────────────────────────────────────────

/// One row per billable third-party call — Kimi (AI), Keepa and Synccentric.
///
/// Exists because none of the three tells you afterwards what a balance was
/// spent on. Kimi exposes a current balance and no usage history at all (probed:
/// /users/me/balance answers, every usage path 404s); Keepa and Synccentric
/// report a running quota in each response but keep no per-project breakdown.
/// So when credits drain, this table is the only account of where they went.
///
/// Each provider is recorded at the single choke point its calls already pass
/// through, so no call site can forget to report: recordUsage() in
/// src/lib/ai/moonshot.ts, captureTokens() in src/lib/keepa/client.ts, and
/// captureQuota() in src/lib/synccentric/client.ts.
///
/// Rows are small and never updated. Retention is handled by the same cleanup
/// cron as the caches.
model ServiceUsage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// kimi | keepa | synccentric
  service String
  /// Model id for kimi (kimi-k2.6, …); null for the metered data providers.
  model String?
  /// What the call was FOR: categorize, verify_image, export_dropdown for AI;
  /// the endpoint (product, search, query) for Keepa and Synccentric.
  feature String

  /// Null for calls outside a project (template detection, connection tests).
  projectId String?
  userId    String?

  /// Kimi only — the provider's own token counts.
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  /// Metered providers — Keepa tokens consumed, Synccentric searches used.
  /// Zero for AI rows, whose cost is in the token columns above.
  units Int @default(0)

  /// Wall-clock duration, for spotting slow paths that also cost.
  durationMs Int?
  /// False when the call threw. Failed calls are still billed by every one of
  /// the three providers, and they were the blind spot in every estimate made
  /// before this table existed.
  ok Boolean @default(true)

  @@index([createdAt])
  @@index([service, createdAt])
  @@index([feature, createdAt])
  @@index([projectId])
}

// ── Export defaults ───────────────────────────────────────────────────────────

/// Admin-set values for required export columns that no data source can answer.
///
/// Some mandatory columns are policy, not product data: California Proposition
/// 65 warning type and the PFAS declaration are legal statements about how the
/// seller trades, identical on every row, and neither the vendor file, the
/// marketplace catalog nor a model may invent them. Measured on the live Best
/// Buy project they were 64 of 462 empty required cells — the single largest
/// group after feature bullets.
///
/// Held per marketplace and per attribute, keyed on the NORMALIZED column key so
/// one entry answers a column whether the template names it by label
/// ("California Proposition 65 Warning: Type") or by Mirakl code
/// ("californiaProposition65Warning.type").
///
/// A default never overwrites real data: it applies only where the column is
/// REQUIRED for that row's category and nothing else filled it.
model ExportDefault {
  id          String   @id @default(cuid())
  /// Null = applies to every team. A team's own row overrides the global one
  /// for that marketplace and column.
  teamId      String?
  marketplace String
  /// normalizeKey() of the column's label or attribute code.
  attribute String
  /// Human label, for the admin screen only.
  label String?
  value String
  updatedAt DateTime @updatedAt
  updatedBy String?

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct, so this constraint does NOT stop two
  /// GLOBAL rows sharing a marketplace+attribute. A partial unique index
  /// covering the teamId IS NULL case is created alongside it in
  /// scripts/apply-pending-tables.ts.
  @@unique([teamId, marketplace, attribute])
  @@index([marketplace])
  @@index([teamId])
}

// ── Resolved product attributes ───────────────────────────────────────────────

/// One resolved value for one product attribute, kept so it is paid for once.
///
/// Required cells that no vendor column answers are filled by a catalog lookup
/// or by the AI fill layer. Both were recomputed on EVERY export: the same
/// feature bullet, the same material, re-asked and re-charged each time a file
/// was regenerated. Worse, a Best Buy export of a real catalog cannot finish
/// that work inside one request — the template writing alone measured 208s
/// against a 300s ceiling, so the AI budget expired before a single batch ran
/// and the cells shipped empty however much credit was available.
///
/// Storing each answer turns that into progress: a run fills what it has time
/// for, the next run reads those back for free and spends its budget on what is
/// still missing, and the file converges on complete. Re-exporting a finished
/// catalog costs nothing.
///
/// `attribute` is the normalized column key, so one row answers the column
/// whether the template names it by label or by Mirakl code, and across every
/// category-prefixed spelling of it.
model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  attribute String
  value     String
  /// catalog | ai — where the value came from, so a cheaper source can later
  /// overwrite a more expensive guess but never the reverse.
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attribute])
  @@index([productId])
}

// ── Balance snapshots ─────────────────────────────────────────────────────────

/// Point-in-time reading of a provider's remaining balance.
///
/// Token counts times a configured rate can only ever ESTIMATE spend: the rate
/// has to be kept in step with the provider's pricing page by hand, and cached
/// input tokens bill at a different rate from fresh ones, which no token total
/// distinguishes. The balance is the provider's own arithmetic and needs no
/// rate at all — the drop between two readings IS the money spent.
///
/// Snapshots are taken whenever the balance is fetched (the sidebar widget, the
/// pre-flight availability check), throttled so a busy screen cannot fill the
/// table. Spend for a window is the sum of the DECREASES between consecutive
/// readings; increases are top-ups and are ignored rather than netted off, so a
/// recharge mid-window cannot hide the spend around it.
model BalanceSnapshot {
  id      String @id @default(cuid())
  /// kimi — the only provider that reports a money balance; Keepa and
  /// Synccentric report quotas, which the usage table already measures exactly.
  service String
  /// Cents, to keep the arithmetic exact. Negative when the account is overdrawn.
  balanceCents Int
  capturedAt   DateTime @default(now())

  @@index([service, capturedAt])
}
